local function Void_Enable()
    if _voidActive then return end
    _voidActive = true

    -- 숨기/텔포: Heartbeat에서 가짜 좌표 적용
    _voidHbConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            local lc = LocalPlayer.Character
            local h = lc and lc:FindFirstChild("HumanoidRootPart")
            if not h then return end
            _voidSavedCF = h.CFrame
            _voidSavedLV = h.AssemblyLinearVelocity
            _voidSavedAV = h.AssemblyAngularVelocity

            if _voidTargetCF then
                -- 발사 페이즈: 타겟 내부로 순간이동
                h.CFrame = _voidTargetCF
                h.AssemblyLinearVelocity = Vector3.zero
                h.AssemblyAngularVelocity = Vector3.zero
            else
                -- 숨기 페이즈: Hide Distance만큼 지하로 숨김 (+랜덤 XZ 지터)
                local depth = Options.Void_HideDistance.Value
                local jitter = Vector3.new(math.random(-80, 80), 0, math.random(-80, 80))
                h.CFrame = CFrame.new(h.CFrame.Position + jitter + Vector3.new(0, -depth, 0))
                h.AssemblyLinearVelocity = Vector3.zero
                h.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end)

    -- 원위치 복귀 (클라이언트 표시 유지)
    RunService:BindToRenderStep("Lynoria_Void", Enum.RenderPriority.First.Value, function()
        if not _voidSavedCF then return end
        pcall(function()
            local lc = LocalPlayer.Character
            local h = lc and lc:FindFirstChild("HumanoidRootPart")
            if not h then return end
            h.CFrame = _voidSavedCF
            h.AssemblyLinearVelocity = _voidSavedLV
            h.AssemblyAngularVelocity = _voidSavedAV
        end)
    end)

    -- 루프: 숨기(0.1초) → 타겟 내부 텔포(0.05초) → 발사 → 반복
    _voidThread = task.spawn(function()
        while _voidActive do
            local tgt = Void_GetTarget()
            if tgt and tgt.Character then
                local hrp = tgt.Character:FindFirstChild("HumanoidRootPart")
                local thead = tgt.Character:FindFirstChild("Head") or hrp
                if hrp and thead then
                    _voidTargetCF = nil -- 숨기
                    task.wait(0.1)
                    if not _voidActive then break end
                    _voidTargetCF = CFrame.new(thead.Position) -- 타겟 내부로
                    task.wait(0.05)
                    if not _voidActive then break end
                    if not PlayerIsDead(tgt) then Void_Fire(thead) end
                    _voidTargetCF = nil
                end
            end
            task.wait(0.1)
        end
        _voidThread = nil
    end)
end

local function Void_Disable()
    _voidActive = false
    if _voidHbConn then _voidHbConn:Disconnect(); _voidHbConn = nil end
    RunService:UnbindFromRenderStep("Lynoria_Void")
    _voidThread = nil
    _voidTargetCF = nil
    _voidTarget = nil
    _voidSavedCF = nil; _voidSavedLV = nil; _voidSavedAV = nil
end

