local _flyBodyVelocity, _flyBodyGyro = nil, nil
local _flyConn, _flyJumpConn, _flySpaceConn, _flySpaceEndConn = nil, nil, nil, nil
local _flyUpFlag, _flyDownFlag = false, false
local _flyJumpTimer = 0
local _flyControls = nil

-- 모바일 터치 스틱 + PC WASD 공용 입력 (PlayerModule 컨트롤)
pcall(function()
    local pm = require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
    _flyControls = pm:GetControls()
end)

local function Fly_GetMoveDir()
    if _flyControls and _flyControls:GetActiveMovementController() then
        local md = _flyControls:GetActiveMovementController().moveDirection
        if md and md.Magnitude > 0.05 then
            return md -- 카메라 기준 좌표 (스틱/WASD 공통)
        end
    end
    return nil
end

local function Fly_Start()
    if _flyBodyVelocity and _flyBodyVelocity.Parent then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.D = 100
    bg.P = 1000
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    _flyBodyVelocity = bv
    _flyBodyGyro = bg

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end

    if not _flyConn then
        _flyConn = RunService.Heartbeat:Connect(function()
            local c = LocalPlayer.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if not _flyBodyVelocity or not _flyBodyVelocity.Parent or not h then return end
            local speed = Options.Fly_Speed.Value

            -- 이동 방향: 스틱/WASD 있으면 그 방향, 없으면 카메라 정면
            local dir
            local md = Fly_GetMoveDir()
            if md then
                dir = Camera.CFrame:VectorToWorldSpace(md)
                dir = Vector3.new(dir.X, 0, dir.Z).Unit
            else
                local look = Camera.CFrame.LookVector
                dir = Vector3.new(look.X, 0, look.Z).Unit
            end

            -- 카메라 상하 각도로 고도 조절 (모바일: 화면 드래그로 위/아래 이동)
            local look = Camera.CFrame.LookVector
            local vertical = look.Y * speed * 0.6

            -- 점프 탭 = 상승, (PC) 좌컨트롤 = 하강
            local up = 0
            local down = 0
            if _flyUpFlag or tick() < _flyJumpTimer then up = 1 end
            if _flyDownFlag then down = 1 end

            local vel = dir * speed + Vector3.new(0, vertical + (up - down) * speed, 0)
            _flyBodyVelocity.Velocity = vel

            -- 몸을 이동 방향으로 세움 (수직 이동 중엔 기존 자세 유지)
            if vel.XZ.Magnitude > 0.5 then
                _flyBodyGyro.CFrame = CFrame.lookAt(h.Position, h.Position + Vector3.new(vel.X, 0, vel.Z))
            end
        end)
    end

    -- 모바일 점프 버튼 / PC 스페이스
    if not _flyJumpConn then
        _flyJumpConn = UserInputService.JumpRequest:Connect(function()
            if Toggles.Fly_Enabled.Value then
                _flyJumpTimer = tick() + 0.3 -- 점프 탭 = 0.3초 상승
            end
        end)
    end
    if not _flySpaceConn then
        _flySpaceConn = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe or not Toggles.Fly_Enabled.Value then return end
            if input.KeyCode == Enum.KeyCode.Space then _flyUpFlag = true
            elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.C then _flyDownFlag = true end
        end)
        _flySpaceEndConn = UserInputService.InputEnded:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.Space then _flyUpFlag = false
            elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.C then _flyDownFlag = false end
        end)
    end
end

local function Fly_Stop()
    if _flyBodyVelocity then pcall(function() _flyBodyVelocity:Destroy() end); _flyBodyVelocity = nil end
    if _flyBodyGyro then pcall(function() _flyBodyGyro:Destroy() end); _flyBodyGyro = nil end
    _flyUpFlag = false; _flyDownFlag = false; _flyJumpTimer = 0
end

Toggles.Fly_Enabled:OnChanged(function()
    if Toggles.Fly_Enabled.Value then
        -- 상호 배제
        if Toggles.HVH_Enabled then Toggles.HVH_Enabled:SetValue(false) end
        if Toggles.Void_Enabled then Toggles.Void_Enabled:SetValue(false) end
        if Toggles.RageBot_Enabled then Toggles.RageBot_Enabled:SetValue(false) end
        if Toggles.KnifeFarm_Enabled then Toggles.KnifeFarm_Enabled:SetValue(false) end
        if Toggles.AutoTp_Enabled then Toggles.AutoTp_Enabled:SetValue(false) end
        StopCsync() -- 플라이 중엔 데싱크 정지
        Fly_Start()
    else
        Fly_Stop()
    end
end)

