local function RB_DoFire(thead)
    local f = RB_GetFighter()
    local i = f and f.EquippedItem
    if not f or not i then return end

    local oid = i:Get("ObjectID")
    local se = rb_enums and rb_enums:ToEnum("StartShooting")

    if not oid or not se or not rb_util then
        pcall(function() i:UseItem() end)
        return
    end

    local cam_pos = Camera.CFrame.Position
    local targetCF = CFrame.lookAt(cam_pos, thead.Position)

    local cameradata = {}
    cameradata[utf8.char(1)] = {
        [utf8.char(0)] = rb_util:EncodeCFrame(Camera.CFrame),
        [utf8.char(1)] = rb_util:EncodeCFrame(targetCF),
        [utf8.char(2)] = thead,
        [utf8.char(3)] = rb_util:EncodeCFrame(thead.CFrame:ToObjectSpace(CFrame.new(thead.Position)))
    }

    pcall(function()
        RS.Remotes.Replication.Fighter.UseItem:FireServer(oid, se, cameradata, nil)
    end)
end

local function RB_HandleAmmo()
    local fighter = RB_GetFighter(); local item = fighter and fighter.EquippedItem
    if not fighter or not item then return false end
    local ammo = item:Get("Ammo") or 0
    if fighter:Get("Reloading") then return true end
    if ammo > 0 then return false end
    return true -- 탄약 없으면 그냥 발사 안 함
end

function StartRageBot()
    if _rbActive then return end
    _rbActive = true; _rbTarget = nil; _orbitAngle = math.random() * (math.pi * 2)
    EnableNoclip(); StartCsync()

    _rbConn = RunService.Stepped:Connect(function(_, dt)
        if not _rbActive or not Toggles.RageBot_Enabled.Value then StopRageBot(); return end
        local lc = LocalPlayer.Character; local lhrp = lc and lc:FindFirstChild("HumanoidRootPart")
        if not lhrp then return end

        if not _rbTarget or PlayerIsDead(_rbTarget) then _rbTarget = RB_GetBestTarget() end
        if not _rbTarget then _csyncFakeCF = nil; return end

        local tc = _rbTarget.Character; local tr = tc and tc:FindFirstChild("HumanoidRootPart"); local thead = tc and (tc:FindFirstChild("Head") or tr)
        if not tr or not thead then _rbTarget = nil; return end

        -- Anti Katana 체크: 타겟이 반사 중이면 사격 중지 및 멈춤
        if Toggles.AntiKatana_Enabled.Value and isTargetDeflecting(tc) then
            _csyncFakeCF = nil
            return
        end

        -- Orbit: 속도 67, 반경 5스터드, 높이 150
        _orbitAngle = _orbitAngle + dt * 67
        local targetPos = thead.Position + Vector3.new(math.cos(_orbitAngle) * 5, 150, math.sin(_orbitAngle) * 5)
        local faceCF = CFrame.new(targetPos, thead.Position)

        _csyncFakeCF = faceCF
        _csyncFakeLV = (targetPos - lhrp.Position) / dt

        if not RB_HandleAmmo() and not PlayerIsDead(_rbTarget) then
            RB_DoFire(thead)
        end
    end)
end

function StopRageBot()
    if not _rbActive then return end
    _rbActive = false; if _rbConn then _rbConn:Disconnect(); _rbConn = nil end
    _rbTarget = nil; _csyncFakeCF = nil; StopCsync(); DisableNoclip()
end

