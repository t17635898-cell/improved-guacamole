local function RB_GetBestTarget()
    local lc = LocalPlayer.Character; local lhrp = lc and lc:FindFirstChild("HumanoidRootPart"); if not lhrp then return nil end
    local best, bestV = nil, math.huge; local useHP = Options.RageBot_TargetMode.Value == "Lowest Health"
    for _, p in Players:GetPlayers() do
        if p == LocalPlayer or isSameTeam(p) or not p.Character then continue end
        if Toggles.KillCheck.Value and PlayerIsDead(p) then continue end
        local c = p.Character; local hrp = c:FindFirstChild("HumanoidRootPart"); local hum = c:FindFirstChild("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end
        local val = useHP and hum.Health or (hrp.Position - lhrp.Position).Magnitude
        if val < bestV then bestV = val; best = p end
    end
    return best
end

