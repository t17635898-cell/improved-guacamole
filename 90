    local deformed = false
    pcall(function()
        -- 스케일 변형 감지 (껍데기 부풀림/축소)
        if hrp.Scale and (hrp.Scale.X > 1.4 or hrp.Scale.X < 0.6) then deformed = true end
        -- 치팅 태그/의심 파츠 감지
        for _, child in ipairs(hrp:GetChildren()) do
            local nm = child.Name:lower()
            if nm:find("hitbox") or nm:find("shell") or nm:find("deflect") or nm:find("fake") or nm:find("lag") or nm:find("desync") then
                deformed = true
            end
        end
    end)
    return deformed
end

-- 감지 범위 극대화: 맵 전체 (10000스터드), 변형 타겟은 우선순위 상향
local function HVH_GetTarget()
    local lc = LocalPlayer.Character
    local lhrp = lc and lc:FindFirstChild("HumanoidRootPart")
    if not lhrp then return nil end
    local best, bestV = nil, math.huge
    for _, p in Players:GetPlayers() do
        if p == LocalPlayer or isSameTeam(p) or not p.Character then continue end
        if Toggles.KillCheck.Value and PlayerIsDead(p) then continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        local head = p.Character:FindFirstChild("Head")
        local hum = p.Character:FindFirstChild("Humanoid")
        if not hrp or not head or not hum or hum.Health <= 0 then continue end
        local dist = (lhrp.Position - hrp.Position).Magnitude
        if dist > 10000 then continue end -- 감지 범위 10000스터드
        local deformed = HVH_DetectShell(p.Character)
        -- 변형 감지된 적은 거리 * 0.1 가중치로 최우선 타겟
        local val = deformed and (dist * 0.1) or dist
        if val < bestV then bestV = val; best = { player = p, hrp = hrp, head = head, deformed = deformed } end
    end
    return best
end

local function HVH_Fire(aimPart)
    local ok, fc = pcall(function() return require(LocalPlayer.PlayerScripts.Controllers.FighterController) end)
    local f = ok and fc and fc.LocalFighter
    local i = f and f.EquippedItem
    if not f or not i then return end

    local oid = i:Get("ObjectID")
    local se = hvh_enums and hvh_enums:ToEnum("StartShooting")
    if not oid or not se or not hvh_util then
        pcall(function() i:UseItem() end)
        return
    end

    local cam_pos = Camera.CFrame.Position
    local cameradata = {}
    cameradata[utf8.char(1)] = {
        [utf8.char(0)] = hvh_util:EncodeCFrame(Camera.CFrame),
        [utf8.char(1)] = hvh_util:EncodeCFrame(CFrame.lookAt(cam_pos, aimPart.Position)),
        [utf8.char(2)] = aimPart,
        [utf8.char(3)] = hvh_util:EncodeCFrame(aimPart.CFrame:ToObjectSpace(CFrame.new(aimPart.Position)))
    }
    pcall(function()
        RS.Remotes.Replication.Fighter.UseItem:FireServer(oid, se, cameradata, nil)
    end)
end

local function HVH_Start()
    if _hvhActive then return end
    _hvhActive = true
    EnableNoclip()
    StopCsync()

    -- 텔포/총알: 매 프레임 타겟 뒤로 이동 + 고속 사격 (데싱크로 원위치 복귀)
    _hvhConn = RunService.Heartbeat:Connect(function()
        if not _hvhActive or not Toggles.HVH_Enabled.Value then HVH_Stop(); return end
        local lc = LocalPlayer.Character
        local lhrp = lc and lc:FindFirstChild("HumanoidRootPart")
        if not lhrp then return end

        -- 원본 좌표 저장 (복귀용)
        _hvhLocalCF = lhrp.CFrame
        _hvhLocalLV = lhrp.AssemblyLinearVelocity
        _hvhLocalAV = lhrp.AssemblyAngularVelocity

        local tgt = HVH_GetTarget()
        if not tgt then
            lhrp.CFrame = _hvhLocalCF
            _hvhTarget = nil
            return
        end
        _hvhTarget = tgt

        -- 껍데기 변형 감지 알림 (1회)
        if tgt.deformed and not _hvhNotified[tgt.player] then
            _hvhNotified[tgt.player] = true
            pcall(function() Library:Notify("HVH: Shell 변형 감지 - " .. tgt.player.Name, 3) end)
        end

        -- 텔포: 매 프레임 타겟 뒤 2스터드 (텔포 범위/속도 극대화)
        local backPos = tgt.hrp.Position - (tgt.hrp.CFrame.LookVector * 2)
        lhrp.CFrame = CFrame.new(backPos, tgt.hrp.Position)

        -- 총알: 0.03초마다 발사 (기본 쿨다운의 수십 배)
        local now = tick()
        if now >= _hvhNextFire then
            _hvhNextFire = now + 0.03
            local aimPart = tgt.head
            if tgt.deformed then
                -- 변형 쉘 감지 시: 실제 맞는 부위로 보정 (머리/HRP 중 유효한 파츠)
                aimPart = tgt.hrp:FindFirstChild("Head") or tgt.head or tgt.hrp
            end
            HVH_Fire(aimPart)
        end
    end)

    -- 원위치 복귀 (서버엔 타겟 뒤, 클라이언트엔 원래 위치)
    RunService:BindToRenderStep("Lynoria_HVH", Enum.RenderPriority.First.Value, function()
        if not _hvhActive then return end
        if _hvhLocalCF then
            local lc = LocalPlayer.Character
            local h = lc and lc:FindFirstChild("HumanoidRootPart")
            if h then
                h.CFrame = _hvhLocalCF
                h.AssemblyLinearVelocity = _hvhLocalLV or Vector3.zero
                h.AssemblyAngularVelocity = _hvhLocalAV or Vector3.zero
            end
        end
    end)
end

local function HVH_Stop()
    if not _hvhActive then return end
    _hvhActive = false
    if _hvhConn then _hvhConn:Disconnect(); _hvhConn = nil end
    RunService:UnbindFromRenderStep("Lynoria_HVH")
    _hvhTarget = nil
    _hvhLocalCF = nil; _hvhLocalLV = nil; _hvhLocalAV = nil
    _csyncFakeCF = nil
    DisableNoclip()
end

Toggles.HVH_Enabled:OnChanged(function()
    if Toggles.HVH_Enabled.Value then
        -- 상호 배제
        if Toggles.Void_Enabled then Toggles.Void_Enabled:SetValue(false) end
        if Toggles.RageBot_Enabled then Toggles.RageBot_Enabled:SetValue(false) end
